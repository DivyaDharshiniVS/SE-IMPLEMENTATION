# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Academic Project: Smart Tourism Planning and Local Guide Recommendation Platform
# ==============================================================================
# IMPORTANT: Copy this file to .env for local overrides. 
# NEVER commit private credentials or API keys to GitHub!

# Application Environment
ENVIRONMENT=development
APP_PORT=8501
