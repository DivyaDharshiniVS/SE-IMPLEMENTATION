# Database Configuration (Defaults to local SQLite if unspecified)
DATABASE_PATH=tourism_platform.db

# Optional Cloud Integrations (Platform functions completely without these)
# MAPS_API_KEY=your_optional_maps_api_key_here
# ANALYTICS_ID=your_optional_analytics_id_here
